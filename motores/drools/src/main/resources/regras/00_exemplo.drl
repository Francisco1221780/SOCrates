package regras;

import cyberrangers.motores.drools.Facto;

// Regra de exemplo, so para provar a ligacao (passo 1 do plano). Apagar quando entrarem as regras reais.
rule "exemplo_alerta_gera_conclusao"
when
    $f : Facto(predicado == "alerta_ids", $a : args)
then
    insert(new Facto("exemplo_conclusao", $a));
end
